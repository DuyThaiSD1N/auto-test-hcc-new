# Copy thanh .env truoc khi chay: docker compose up -d
APP_SECRET_KEY=thay-bang-ket-qua-cua-openssl-rand-hex-32
APP_DEFAULT_USERNAME=admin
APP_DEFAULT_PASSWORD=doi-mat-khau-nay
APP_DEFAULT_FULL_NAME=Quan tri vien
APP_ACCESS_TOKEN_EXPIRE_MINUTES=480
# MongoDB luu lich su + JSON boc tach. Dung docker compose thi de nguyen ten dich vu "mongo".
APP_MONGO_URI=mongodb://mongo:27017
APP_MONGO_DB=auto_test_hcc

# Nguon boc tach: "batch" (API theo lo) hoac "internal" (BE noi bo)
APP_EXTRACT_PROVIDER=batch

# Nguon 1 - API boc tach theo lo
APP_BATCH_API_BASE_URL=https://trolyhoso-hcc-admin.vnekyc.vn
APP_BATCH_API_SECRET=secret-do-doi-auto-fill-hcc-cap

# Nguon 2 - BE noi bo Auto Fill HCC (POST /api/v1/process)
APP_INTERNAL_API_BASE_URL=http://host.docker.internal:8080
APP_INTERNAL_USERNAME=
APP_INTERNAL_PASSWORD=
APP_INTERNAL_CONCURRENCY=2

# Duong dan LibreOffice de doc DOC/RTF/ODT (de trong = tu do trong PATH)
APP_SOFFICE_PATH=
