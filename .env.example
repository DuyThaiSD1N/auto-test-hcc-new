# ============================================================================
# Cấu hình Auto Test HCC — dùng cho `docker compose up -d`
#
# Copy thành .env rồi điền. File .env đã nằm trong .gitignore.
# Muốn dán lên Render: Dashboard → service → Environment → "Add from .env"
# rồi dán TOÀN BỘ file này (Render bỏ qua dòng bắt đầu bằng #).
# ============================================================================

# ---- Bắt buộc đổi trước khi chạy thật -------------------------------------
# Sinh khóa: openssl rand -hex 32
APP_SECRET_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu

# Tài khoản đăng nhập mặc định (bootstrap khi CSDL còn trống).
# ĐÂY LÀ MẬT KHẨU DÙNG ĐỂ ĐĂNG NHẬP TRÊN BẢN DEPLOY — không phải admin123 ở máy cá nhân.
APP_DEFAULT_USERNAME=admin
APP_DEFAULT_PASSWORD=doi-mat-khau-nay
APP_DEFAULT_FULL_NAME=Quan tri vien

# Thời gian sống của phiên đăng nhập (phút)
APP_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- MongoDB: lịch sử phiên quét + JSON bóc tách + tài khoản ---------------
# Docker Compose: để nguyên "mongo" (tên dịch vụ trong compose).
# Render: KHÔNG có Mongo dựng sẵn -> dùng MongoDB Atlas, dán chuỗi kết nối dạng
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Để trống thì ứng dụng vẫn chạy, chỉ mất lịch sử và không tạo được tài khoản.
APP_MONGO_URI=mongodb://mongo:27017
APP_MONGO_DB=auto_test_hcc
APP_MONGO_TIMEOUT_MS=5000

# ---- Nguồn bóc tách: "batch" hoặc "internal" ------------------------------
APP_EXTRACT_PROVIDER=batch

# Nguồn 1 — API bóc tách theo lô của Auto Fill HCC
APP_BATCH_API_BASE_URL=https://trolyhoso-hcc-admin.vnekyc.vn
APP_BATCH_API_SECRET=
APP_BATCH_API_TIMEOUT=180

# OCR cua ho so chay qua API theo lo: API batch khong tra OCR, nhung worker Auto Fill HCC
# cat OCR vao collection `ocr_cache` trong Mongo cua BE (TTL 12 gio). Tro toi Mongo do de
# xem OCR; app se luu lai OCR vao Mongo cua minh de khong mat sau TTL. De trong = khong xem OCR.
#   mongodb://<user>:<pass>@<host>:<port>/?authSource=admin
APP_OCR_CACHE_MONGO_URI=
APP_OCR_CACHE_DB=autofill_hcc


# Nguồn 2 — BE nội bộ Auto Fill HCC (POST /api/v1/process)
# CHÚ Ý khi deploy: 127.0.0.1 là chính máy chủ chạy app, KHÔNG phải máy bạn.
# Trên Render phải là địa chỉ công khai của BE nội bộ thì mới gọi được.
APP_INTERNAL_API_BASE_URL=http://127.0.0.1:8080
APP_INTERNAL_USERNAME=
APP_INTERNAL_PASSWORD=
APP_INTERNAL_TIMEOUT=300
APP_INTERNAL_CONCURRENCY=2

# ---- Tài khoản QUẢN TRỊ của BE nội bộ (tùy chọn) --------------------------
# Chỉ dùng để đọc văn bản OCR của từng hồ sơ: BE lưu OCR trong /api/v1/traces,
# mà API đó chỉ cho tài khoản admin. Để trống = không xem được OCR, phần còn lại vẫn chạy.
APP_INTERNAL_ADMIN_USERNAME=
APP_INTERNAL_ADMIN_PASSWORD=

# ---- Deploy ra may chu ngoai MA VAN XEM DUOC OCR ---------------------------
# Host cong khai chay CUNG mot ung dung voi BE noi bo (co /auth/login,
# /api/v1/process, /api/v1/traces) nen dung nguon "internal" tro thang vao do:
#   APP_EXTRACT_PROVIDER=internal
#   APP_INTERNAL_API_BASE_URL=https://trolyhoso-hcc-admin.vnekyc.vn
#   APP_INTERNAL_USERNAME / PASSWORD              -> tai khoan thuong TREN HE THONG DO
#   APP_INTERNAL_ADMIN_USERNAME / PASSWORD        -> tai khoan admin TREN HE THONG DO (doc OCR)
# Dung nguon "batch" thi KHONG co OCR: worker cua API theo lo khong ghi trace.


# ---- Tùy chọn -------------------------------------------------------------
# Đường dẫn LibreOffice để đọc DOC/RTF/ODT; để trống thì tự dò trong PATH.
APP_SOFFICE_PATH=

# Giới hạn dung lượng (byte): 80MB mỗi file, 100MB mỗi hồ sơ
APP_MAX_FILE_BYTES=83886080
APP_MAX_ITEM_BYTES=104857600
